<html lang='en'>

    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=' />
        <title>{{title}}</title>
    </head>

    <body style='margin:0;font-family:arial'>
        <table style='border:0;width:100%'>
            <tr style='background:#17A2B8'>
                <td style='padding:20px;color:#ffffff;text-align:center;font-size:40px;font-weight:600'>
                    {{app_name}}
                </td>
            </tr>
            <tr>
                <td style='padding:10px;color:#808080;text-align:center;font-size:20px;font-weight:600'>
                    {{mail_heading}}
                </td>
            </tr>
            <tr>
                <td style='padding:10px;color:#808080;font-size:18px;font-weight:100;text-align:center;'>
                    <strong>Dear {{mail_account_name}}</strong><br />
                </td>
            </tr>
            <tr>
                <td style='padding:10px;color:#808080;font-size:14px;font-weight:100;text-align:center;'>
                    {{text1}}
                    {{app_name}}<br />
                    {{text2}}<br />
                    {{text3}}<br />
                    {{text4}}
                    {{mail_account_name}}
                    at
                    {{app_name}}
                </td>
            </tr>
            <tr>
                <td style='text-align:center'>
                    <span style='font-size:13px;padding:20px;text-decoration:none;color:#9E9EBC'>
                        Please ignore this email if you did not register an account through
                        {{app_name}}.
                    </span>
                </td>
            </tr>
        </table>
    </body>

</html>