NODE_ENV=development
PWD=
ROOT_KEY=

APP_NAME=App
APP_PORT=3000
API_PREFIX=api
APP_VERSION=v1
APP_CLIENT_HOST=http://localhost:3000
APP_SERVER_HOST=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DIR=logs
LOG_NAME=app

DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dbsample
DB_USERNAME=postgres
DB_PASSWORD=
DB_SYNCHRONIZE=true // turn it off, on production
DB_MAX_CONNECTIONS=100
DB_SSL_ENABLED=false
DB_REJECT_UNAUTHORIZED=false
DB_CA=
DB_KEY=
DB_CERT=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Support "local", "s3"
FILE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_S3_URL=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=
AWS_CLOUDFRONT_URL=
MAX_FILE_SIZE=2048

MAIL_MAILER=ethereal
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_AUTH_USER=your@ethereal.email
MAIL_AUTH_PASS=
MAIL_SECURE=false
MAIL_IGNORE_TLS=true
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@ethereal.email
MAIL_DEFAULT_NAME="Support Team"
MAIL_CLIENT_PORT=1080

JWT_SECRET=secret
JWT_TOKEN_EXPIRES_IN=1d
JWT_REFRESH_SECRET=secret_for_refresh
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
JWT_QR_SECRET=secret_for_qr
JWT_QR_TOKEN_EXPIRES_IN=1h
JWT_QR_TOKEN_BLACKLIST_EXPIRES_IN=1m
JWT_ISSUER=
JWT_AUDIENCE=

SWAGGER_SITE_TITLE="API"
SWAGGER_DOC_TITLE="API"
SWAGGER_DOC_DESCRIPTION="API documentation"
SWAGGER_DOC_VERSION="1.0"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFICATION_SERVICE_SID=
TWILIO_SENDER_PHONE_NUMBER=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=
STRIPE_PAYMENT_EXPIRES_IN=300 // in seconds

SOCKETIO_SERVER_PORT=4110
SOCKETIO_SERVER_PATH=
SOCKETIO_SERVER_CORS_ORIGIN=http://localhost:4200,http://localhost.com:8080