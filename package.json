{
    "name": "hotel-booking-api",
    "version": "0.0.1",
    "description": "Hotel Booking API",
    "author": "Sigit Prayitno <cybergitt@gmail.com>",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "rm -rf dist",
        "build": "nest build",
        "build:swc": "npx swc src -d dist",
        "format": "prettier --write --ignore-unknown \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start swc --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prepare": "npx husky install && chmod +x .husky/pre-commit",
        "type-check": "tsc --noEmit",
        "typeorm": "npx ts-node ./node_modules/.bin/typeorm",
        "migration:create": "yarn typeorm migration:create",
        "migration:generate": "yarn typeorm -d src/infrastructure/database/ormconfig.ts migration:generate",
        "migration:run": "yarn typeorm -d src/infrastructure/database/ormconfig.ts migration:run",
        "migration:revert": "yarn typeorm -d src/infrastructure/database/ormconfig.ts migration:revert",
        "documentation:serve": "npx @compodoc/compodoc -p tsconfig.json --serve --theme Readthedocs"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.386.0",
        "@aws-sdk/protocol-http": "^3.374.0",
        "@aws-sdk/s3-request-presigner": "^3.386.0",
        "@aws-sdk/url-parser": "^3.374.0",
        "@aws-sdk/util-format-url": "^3.378.0",
        "@nestjs/cache-manager": "^2.1.0",
        "@nestjs/common": "^9.0.0",
        "@nestjs/config": "^3.0.0",
        "@nestjs/core": "^9.0.0",
        "@nestjs/event-emitter": "^2.0.3",
        "@nestjs/jwt": "^10.1.0",
        "@nestjs/mapped-types": "^2.0.2",
        "@nestjs/passport": "^10.0.0",
        "@nestjs/platform-express": "^9.0.0",
        "@nestjs/platform-socket.io": "^10.2.8",
        "@nestjs/schedule": "^3.0.3",
        "@nestjs/throttler": "^4.2.1",
        "@nestjs/typeorm": "^10.0.0",
        "@nestjs/websockets": "^10.2.8",
        "@smithy/hash-node": "^2.0.17",
        "@types/lodash": "^4.14.197",
        "@types/multer": "^1.4.7",
        "bcryptjs": "^2.4.3",
        "cache-manager": "^5.2.3",
        "cache-manager-ioredis-yet": "^1.2.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "crypto-js": "^4.1.1",
        "decimal.js": "^10.4.3",
        "dotenv": "^16.3.1",
        "handlebars": "^4.7.7",
        "helmet": "^7.0.0",
        "lodash": "^4.17.21",
        "luxon": "^3.3.0",
        "ms": "^2.1.3",
        "nanoid": "3",
        "nest-winston": "^1.9.3",
        "nodemailer": "^6.9.4",
        "passport": "^0.6.0",
        "passport-anonymous": "^1.0.1",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pg": "^8.11.1",
        "reflect-metadata": "^0.1.13",
        "remove": "^0.1.5",
        "rxjs": "^7.2.0",
        "stripe": "^13.2.0",
        "twilio": "^4.18.1",
        "typeorm": "^0.3.17",
        "winston": "^3.10.0",
        "winston-daily-rotate-file": "^4.7.1"
    },
    "devDependencies": {
        "@compodoc/compodoc": "^1.1.22",
        "@nestjs/cli": "^9.0.0",
        "@nestjs/schematics": "^9.0.0",
        "@nestjs/testing": "^9.0.0",
        "@swc/cli": "^0.1.62",
        "@swc/core": "^1.3.74",
        "@swc/jest": "^0.2.27",
        "@types/bcryptjs": "^2.4.2",
        "@types/crypto-js": "^4.1.1",
        "@types/express": "^4.17.13",
        "@types/jest": "29.5.0",
        "@types/luxon": "^3.3.1",
        "@types/ms": "^0.7.31",
        "@types/node": "18.15.11",
        "@types/node-cron": "^3.0.8",
        "@types/nodemailer": "^6.4.8",
        "@types/passport-anonymous": "^1.0.3",
        "@types/passport-jwt": "^3.0.9",
        "@types/passport-local": "^1.0.35",
        "@types/supertest": "^2.0.11",
        "@typescript-eslint/eslint-plugin": "^5.0.0",
        "@typescript-eslint/parser": "^5.0.0",
        "eslint": "^8.0.1",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "husky": "^8.0.0",
        "jest": "^29.6.2",
        "lint-staged": "^13.2.3",
        "prettier": "^2.3.2",
        "source-map-support": "^0.5.20",
        "supertest": "^6.1.3",
        "ts-jest": "29.0.5",
        "ts-loader": "^9.2.3",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "4.2.0",
        "typescript": "^4.7.4"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s?$": [
                "@swc/jest"
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "lint-staged": {
        "**/*.ts": "yarn lint",
        "**/*.*": "yarn format",
        "*.js": "eslint --cache --fix"
    }
}
