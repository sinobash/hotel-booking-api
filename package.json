{
    "name": "hotel-booking-api",
    "version": "0.0.1",
    "description": "Hotel Booking API",
    "author": "Sigit Prayitno <cybergitt@gmail.com>",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "rm -rf dist",
        "build": "nest build",
        "build:swc": "npx swc src -d dist",
        "format": "prettier --write --ignore-unknown \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start swc --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prepare": "husky",
        "type-check": "tsc --noEmit",
        "typeorm": "npx ts-node ./node_modules/.bin/typeorm",
        "migration:create": "yarn typeorm migration:create",
        "migration:generate": "yarn typeorm -d src/infrastructure/database/ormconfig.ts migration:generate",
        "migration:run": "yarn typeorm -d src/infrastructure/database/ormconfig.ts migration:run",
        "migration:revert": "yarn typeorm -d src/infrastructure/database/ormconfig.ts migration:revert",
        "documentation:serve": "npx @compodoc/compodoc -p tsconfig.json --serve --theme Readthedocs"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.386.0",
        "@aws-sdk/protocol-http": "^3.374.0",
        "@aws-sdk/s3-request-presigner": "^3.386.0",
        "@aws-sdk/url-parser": "^3.374.0",
        "@aws-sdk/util-format-url": "^3.378.0",
        "@nestjs/cache-manager": "^3.1.3",
        "@nestjs/common": "^11.2.7",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.7",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "^2.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.2.7",
        "@nestjs/platform-socket.io": "^11.2.7",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/throttler": "^6.7.1",
        "@nestjs/typeorm": "^11.0.3",
        "@nestjs/websockets": "^11.2.7",
        "@smithy/hash-node": "^2.0.17",
        "@types/multer": "^1.4.7",
        "bcryptjs": "^2.4.3",
        "cache-manager": "^6.4.3",
        "cache-manager-ioredis-yet": "^2.1.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "crypto-js": "^4.1.1",
        "decimal.js": "^10.4.3",
        "dotenv": "^16.3.1",
        "handlebars": "^4.7.7",
        "helmet": "^8.3.0",
        "luxon": "^3.3.0",
        "ms": "^2.1.3",
        "nest-winston": "^1.9.3",
        "nodemailer": "^6.9.4",
        "passport": "^0.7.0",
        "passport-anonymous": "^1.0.1",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pg": "^8.11.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.2.0",
        "stripe": "^18.5.0",
        "twilio": "^5.13.1",
        "typeorm": "^0.3.31",
        "winston": "^3.10.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@compodoc/compodoc": "^1.1.22",
        "@eslint/js": "^9.39.5",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.7",
        "@swc/cli": "^0.7.10",
        "@swc/core": "^1.3.74",
        "@swc/jest": "^0.2.27",
        "@types/bcryptjs": "^2.4.2",
        "@types/crypto-js": "^4.1.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/luxon": "^3.3.1",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.20.5",
        "@types/nodemailer": "^6.4.8",
        "@types/passport-anonymous": "^1.0.3",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.35",
        "@types/supertest": "^7.2.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.10",
        "source-map-support": "^0.5.20",
        "supertest": "^7.3.1",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "4.2.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.1"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s?$": [
                "@swc/jest"
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "lint-staged": {
        "**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "engines": {
        "node": ">=20"
    }
}
